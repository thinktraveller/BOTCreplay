{
  "name": "botcreplay",
  "version": "0.1.0",
  "description": "血染钟楼本地复盘编辑器，支持角色配置、时间轴记录及 HTML / PNG 导出。",
  "repository": {
    "type": "git",
    "url": "https://github.com/thinktraveller/BOTCreplay.git"
  },
  "homepage": "https://github.com/thinktraveller/BOTCreplay/blob/project-docs/README.md",
  "bugs": {
    "url": "https://github.com/thinktraveller/BOTCreplay/issues"
  },
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0 || ^24.0.0 || >=26.0.0", "npm": ">=10" },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "check": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "npm run check && node scripts/build.mjs && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "start:local": "node scripts/start-local.mjs",
    "release:local": "npm run build && node scripts/package-local.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "html-to-image": "1.11.13",
    "jsonc-parser": "3.3.1",
    "pinia": "4.1.0",
    "sharp": "0.35.5",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "vue-tsc": "3.3.13"
  }
}
